# Checksum-sensitive data must keep the bytes as committed on every
# platform. Git must not convert line endings in these files (for example
# core.autocrlf=true on Windows), because the conformance suite checks the
# fixtures by SHA-256 and compares the generated JSON (conformance/cases and
# conformance/cross) byte for byte. build_cases.py and gen_fold_table.py
# write LF bytes on every OS.
# The SDK copies of the name fold table, and the TypeScript and C tables
# generated from it, are also compared with the suite's table.
*.gz                  binary
*.jsonl               -text
*.sha256              -text
conformance/fixtures/** -text
conformance/cases/*.json -text
conformance/cross/*.json -text
conformance/api.json  -text
conformance/schemas/** -text
name_fold.json        -text
js/src/fold-table.ts  -text
c/src/otc_fold_table.c -text
# Byte-checked on every platform too: the vendored sources (their SHA-256 is
# checked), the C supported-formats.json (cmp against the bundle), and the
# Ruby README, whose code blocks test_readme.rb reads in binary mode.
c/vendor/**           -text
c/supported-formats.json -text
ruby/README.md        -text
