  {
   "id": "cross/lock-contention",
   "title": "two SDKs open the same uncached release at once: the lock directory stops the second download",
   "spec": "5.4",
   "roles": {
    "writer": [
     "fs",
     "fetch",
     "stream"
    ],
    "reader": [
     "fs",
     "fetch",
     "stream"
    ]
   },
   "timeout_s": 90,
   "steps": [
    {
     "driver": "server_rules",
     "rules": [
      {
       "match": "/good/OTC_20991231\\.2\\.jsonl$",
       "action": "slow",
       "delay_s": 2
      }
     ]
    },
    {
     "as": [
      "writer",
      "reader"
     ],
     "op": "open",
     "args": {
      "release": "20991231.2",
      "base_url": "${server}/good/",
      "cache_dir": "${cache}",
      "mode": "stream"
     },
     "expect": {
      "loaded_from": {
       "$any_of": [
        "download",
        "cache"
       ]
      },
      "datestamp": "20991231.2"
     }
    },
    {
     "as": [
      "writer",
      "reader"
     ],
     "op": "station_count",
     "expect": {
      "station_count": 20
     }
    },
    {
     "driver": "assert_requests",
     "source": "server",
     "match": "/good/OTC_20991231\\.2\\.jsonl$",
     "status": 200,
     "count": 1
    },
    {
     "driver": "assert_files",
     "dir": "${cache}/v1/releases/20991231.2",
     "present": [
      ".verified",
      "index-v1.json"
     ],
     "absent": [
      ".lock"
     ],
     "no_tmp": true
