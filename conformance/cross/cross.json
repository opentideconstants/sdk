{
 "suite_version": "1.0",
 "group": "cross",
 "description": "Generated by conformance/tools/build_cases.py from conformance/fixtures; do not edit. Run with driver.py --cross NAME=COMMAND (two or more runners).",
 "cases": [
  {
   "id": "cross/cache-offline-stream",
   "title": "one SDK fills the cache in stream mode; another opens it offline (server stopped) and gets the same answers, with no request",
   "spec": "5.4, 5.5, 6.2",
   "roles": {
    "writer": [
     "fs",
     "fetch",
     "stream"
    ],
    "reader": [
     "fs",
     "fetch",
     "stream"
    ]
   },
   "steps": [
    {
     "as": "writer",
     "op": "open",
     "args": {
      "release": "20991231.2",
      "base_url": "${server}/good/",
      "cache_dir": "${cache}",
      "mode": "stream"
     },
     "expect": {
      "loaded_from": "download",
      "datestamp": "20991231.2"
     }
    },
    {
     "as": "writer",
     "op": "station_count",
     "expect": {
      "station_count": 20
     }
    },
    {
     "as": "writer",
     "op": "close"
    },
    {
     "driver": "assert_files",
     "dir": "${cache}/v1/releases/20991231.2",
     "present": [
      ".verified",
      "OTC_20991231.2.sha256",
      "OTC_20991231.2.jsonl",
      "OTC_20991231.2.meta.json",
      "index-v1.json"
     ],
     "absent": [
      ".lock"
     ],
     "no_tmp": true
    },
    {
     "driver": "assert_index",
     "path": "${cache}/v1/releases/20991231.2/index-v1.json",
     "jsonl": "${cache}/v1/releases/20991231.2/OTC_20991231.2.jsonl",
     "datestamp": "20991231.2"
    },
    {
     "driver": "server_stop"
    },
    {
     "driver": "clear_log"
    },
    {
     "as": "reader",
     "op": "open",
     "args": {
      "release": "20991231.2",
      "cache_dir": "${cache}",
      "offline": true,
      "mode": "stream"
     },
     "expect": {
      "loaded_from": "cache",
      "datestamp": "20991231.2"
     }
    },
    {
     "as": "reader",
     "op": "verify",
     "expect": {
      "verified": true
     }
    },
    {
     "as": "reader",
     "op": "release_files",
     "expect": {
      "files": {
       "$len_min": 4
      }
     }
    },
    {
     "as": "reader",
     "op": "station_count",
     "expect": {
      "station_count": 20
     }
    },
    {
     "as": "reader",
     "op": "tombstone_count",
     "expect": {
      "tombstone_count": 2
     }
    },
    {
     "as": "reader",
     "op": "near",
     "args": {
      "lat": 0.0,
      "lon": 179.95,
      "radius_km": 50
     },
     "expect": {
      "station_ids": [
       "OTC-T-0007",
       "OTC-T-0008"
      ],
      "distance_km": [
       5.559754011674749,
       16.679262035030458
      ],
      "tolerance": 1e-06
     }
    },
    {
     "as": "reader",
     "op": "search",
     "args": {
      "name": "tromso"
     },
     "expect": {
      "station_ids": [
       "OTC-T-0006"
      ]
     }
    },
    {
     "as": "reader",
     "op": "stations",
     "args": {
      "kind": "current"
     },
     "expect": {
      "station_ids": [
       "OTC-T-0019"
      ]
     }
    },
    {
     "as": "reader",
     "op": "station",
     "args": {
      "station_id": "OTC-T-0003"
     },
     "expect": {
      "station": {
       "station_id": "OTC-T-0003",
       "name": "Alameda",
       "country": "USA",
       "lat": 37.772,
       "lon": -122.3,
       "type": "subordinate",
       "kind": "tide",
       "timezone": "America/Los_Angeles",
       "aliases": {
        "noaa": [
         "9900003"
        ]
       },
       "status": "active",
       "is_reference": false,
       "is_subordinate": true,
       "is_tide": true,
       "is_current": false,
       "recommended_set_id": null
      }
     }
    },
    {
     "as": "reader",
     "op": "citation",
     "expect": {
      "citation": "OpenTideConstants contributors (2099). OpenTideConstants, release 20991231.2 [Data set]. https://doi.org/10.5072/zenodo.1"
     }
    },
    {
     "as": "reader",
     "op": "attribution",
     "args": {
      "station_ids": [
       "OTC-T-0006",
       "OTC-T-0010",
       "OTC-T-0007"
      ]
     },
     "expect": {
      "attribution": "Tidal constants: OpenTideConstants 20991231.2, doi:10.5072/zenodo.1, CC BY 4.0. Sources: Example Tide Model Group: Example tide model, interpolated by OpenTideConstants tests.; Example Gauge Agency via GESLA: Contains synthetic test data in the style of GESLA-4.; Example Mapping Authority: Synthetic test data, Example Mapping Authority."
     }
    },
    {
     "as": "reader",
     "op": "open",
     "args": {
      "cache_dir": "${cache}",
      "offline": true,
      "mode": "stream"
     },
     "expect": {
      "loaded_from": "cache",
      "datestamp": "20991231.2"
     }
    },
    {
     "as": "reader",
     "op": "cached_releases",
     "expect": {
      "datestamps": [
       "20991231.2"
      ]
     }
    },
    {
     "driver": "assert_requests",
     "source": "any",
     "count": 0
    },
    {
     "driver": "assert_index",
     "path": "${cache}/v1/releases/20991231.2/index-v1.json",
     "jsonl": "${cache}/v1/releases/20991231.2/OTC_20991231.2.jsonl",
     "datestamp": "20991231.2"
    }
   ]
  },
