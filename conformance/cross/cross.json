  {
   "id": "cross/index-shared",
   "title": "the reader uses the stream index the writer built (a fresh index is read, not rebuilt)",
   "spec": "6.2",
   "roles": {
    "writer": [
     "fs",
     "fetch",
     "stream"
    ],
    "reader": [
     "fs",
     "fetch",
     "stream"
    ]
   },
   "steps": [
    {
     "as": "writer",
     "op": "open",
     "args": {
      "release": "20991231.2",
      "base_url": "${server}/good/",
      "cache_dir": "${cache}",
      "mode": "stream"
     },
     "expect": {
      "loaded_from": "download",
      "datestamp": "20991231.2"
     }
    },
    {
     "as": "writer",
     "op": "station_count",
     "expect": {
      "station_count": 20
     }
    },
    {
     "as": "writer",
     "op": "close"
    },
    {
     "driver": "assert_files",
     "dir": "${cache}/v1/releases/20991231.2",
     "present": [
      ".verified",
      "OTC_20991231.2.sha256",
      "OTC_20991231.2.jsonl",
      "OTC_20991231.2.meta.json",
      "index-v1.json"
     ],
     "absent": [
      ".lock"
     ],
     "no_tmp": true
    },
    {
     "driver": "assert_index",
     "path": "${cache}/v1/releases/20991231.2/index-v1.json",
     "jsonl": "${cache}/v1/releases/20991231.2/OTC_20991231.2.jsonl",
     "datestamp": "20991231.2"
    },
    {
     "driver": "json_set",
     "path": "${cache}/v1/releases/20991231.2/index-v1.json",
     "pointer": "/stations/10/country",
     "value": "ZZ"
    },
    {
     "driver": "copy",
     "files": [
      "${cache}/v1/releases/20991231.2/index-v1.json"
     ],
     "to": "${tmp}/index-copy"
    },
    {
     "driver": "server_stop"
    },
    {
     "driver": "clear_log"
    },
    {
     "as": "reader",
     "op": "open",
     "args": {
      "release": "20991231.2",
      "cache_dir": "${cache}",
      "offline": true,
      "mode": "stream"
     },
     "expect": {
      "loaded_from": "cache",
      "datestamp": "20991231.2"
     }
    },
    {
     "as": "reader",
     "op": "stations",
     "args": {
      "country": "ZZ"
     },
     "expect": {
      "station_ids": [
       "OTC-T-0011"
      ]
     }
    },
    {
     "as": "reader",
     "op": "close"
    },
    {
     "driver": "assert_sha256",
     "path": "${cache}/v1/releases/20991231.2/index-v1.json",
     "equals": "${tmp}/index-copy/index-v1.json"
    },
    {
     "driver": "assert_requests",
     "source": "any",
     "count": 0
    }
   ]
  },
