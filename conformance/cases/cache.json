{
 "suite_version": "1.0",
 "group": "cache",
 "description": "Generated by conformance/tools/build_cases.py from conformance/fixtures; do not edit.",
 "cases": [
  {
   "id": "cache/cached-releases-counter-order",
   "title": "cached_releases orders by counter: 20991231.10 before 20991231.2",
   "spec": "4.3, 4.3.1",
   "requires": [
    "fs"
   ],
   "steps": [
    {
     "op": "open",
     "args": {
      "release": "20991231.10",
      "base_url": "${server}/order/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "datestamp": "20991231.10"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "open",
     "args": {
      "release": "20991231.2",
      "base_url": "${server}/order/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "datestamp": "20991231.2"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "cached_releases",
     "expect": {
      "datestamps": [
       "20991231.10",
       "20991231.2"
      ]
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    }
   ]
  },
  {
