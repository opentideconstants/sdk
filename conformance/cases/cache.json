   "spec": "4.3",
   "requires": [
    "fs"
   ],
   "steps": [
    {
     "op": "open",
     "args": {
      "release": "20991231",
      "base_url": "${server}/good/",
      "cache_dir": "${cache}"
     },
     "expect": {
