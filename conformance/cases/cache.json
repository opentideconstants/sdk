     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "cached_releases",
     "expect": {
      "datestamps": [
       "20991231.10"
      ]
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    }
   ]
  },
