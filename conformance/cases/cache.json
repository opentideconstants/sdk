     "args": {
      "release": "20991231.2",
      "base_url": "${server}/good/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "datestamp": "20991231.2"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
