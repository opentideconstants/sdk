     "expect": {
      "datestamp": "20991231.2"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "open",
     "args": {
      "release": "20991231.10",
      "base_url": "${server}/order/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "datestamp": "20991231.10"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "prune",
     "args": {
      "keep": 1
     },
     "expect": {
      "removed": [
       "20991231.2"
