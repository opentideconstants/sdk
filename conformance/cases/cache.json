  {
   "id": "cache/verify",
   "title": "verify on a cached release passes, and fails after a cached file changes",
   "spec": "4.3, 5.3",
   "requires": [
    "fs"
   ],
   "steps": [
    {
     "op": "open",
     "args": {
      "base_url": "${server}/good/",
      "cache_dir": "${cache}",
      "mode": "stream"
     },
     "expect": {
      "loaded_from": "download",
      "datestamp": "20991231.2"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "verify",
     "expect": {
      "verified": true
     }
    },
    {
     "driver": "corrupt",
     "path": "${cache}/v1/releases/20991231.2/OTC_20991231.2.jsonl",
     "offset": 50
    },
    {
     "op": "verify",
     "expect": {
      "error": "checksum_mismatch"
     }
    }
   ]
  },
  {
   "id": "cache/not-writable",
   "title": "a cache directory that cannot be created: cache error",
   "spec": "4.8",
   "requires": [
    "fs"
   ],
   "steps": [
    {
     "driver": "write",
     "path": "${tmp}/not-a-dir",
     "text": "x"
    },
    {
     "op": "open",
     "args": {
      "base_url": "${server}/good/",
      "cache_dir": "${tmp}/not-a-dir/cache"
     },
     "expect": {
      "error": "cache"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    }
   ]
  },
