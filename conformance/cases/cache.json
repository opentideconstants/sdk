{
 "suite_version": "0.1",
 "group": "cache",
 "description": "Generated by conformance/tools/build_cases.py from conformance/fixtures; do not edit.",
 "cases": [
  {
   "id": "cache/cached-releases",
   "title": "cached_releases lists the cached datestamps, newest first",
   "spec": "4.3",
   "requires": [
    "fs"
   ],
   "steps": [
    {
     "op": "open",
     "args": {
      "release": "20991231",
      "base_url": "${server}/good/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "datestamp": "20991231"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "open",
     "args": {
      "release": "20991231.2",
      "base_url": "${server}/good/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "datestamp": "20991231.2"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "cached_releases",
     "expect": {
      "datestamps": [
       "20991231.2",
       "20991231"
      ]
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    }
   ]
  },
  {
   "id": "cache/prune",
   "title": "prune(keep: 1) removes the older release and returns it",
   "spec": "4.3",
   "requires": [
    "fs"
   ],
   "steps": [
    {
     "op": "open",
     "args": {
      "release": "20991231",
      "base_url": "${server}/good/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "datestamp": "20991231"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "open",
     "args": {
      "release": "20991231.2",
      "base_url": "${server}/good/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "datestamp": "20991231.2"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "prune",
     "args": {
      "keep": 1
     },
     "expect": {
      "removed": [
       "20991231"
      ]
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "cached_releases",
     "expect": {
      "datestamps": [
       "20991231.2"
      ]
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "driver": "assert_files",
     "dir": "${cache}/v1/releases",
     "absent": [
      "20991231"
     ],
     "present": [
      "20991231.2"
     ]
    }
   ]
  },
  {
   "id": "cache/prune-keeps-loaded",
   "title": "prune never removes the loaded release",
   "spec": "4.3",
   "requires": [
    "fs"
   ],
   "steps": [
    {
     "op": "open",
     "args": {
      "release": "20991231",
      "base_url": "${server}/good/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "datestamp": "20991231"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "open",
     "args": {
      "release": "20991231.2",
      "base_url": "${server}/good/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "datestamp": "20991231.2"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "open",
     "args": {
      "release": "20991231",
      "base_url": "${server}/good/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "loaded_from": "cache",
      "datestamp": "20991231"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "prune",
     "args": {
      "keep": 1
     },
     "expect": {
      "removed": []
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "cached_releases",
     "expect": {
      "datestamps": [
       "20991231.2",
       "20991231"
      ]
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    }
   ]
  },
  {
   "id": "cache/prune-invalid",
   "title": "prune with a negative keep: invalid_argument",
   "spec": "4.3, 4.8",
   "requires": [
    "fs"
   ],
   "steps": [
    {
     "op": "open",
     "args": {
      "base_url": "${server}/good/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "loaded_from": "download",
      "datestamp": "20991231.2"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "prune",
     "args": {
      "keep": -1
     },
     "expect": {
      "error": "invalid_argument"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    }
   ]
  },
  {
   "id": "cache/verify",
   "title": "verify on a cached release passes, and fails after a cached file changes",
   "spec": "4.3, 5.3",
   "requires": [
    "fs"
   ],
   "steps": [
    {
     "op": "open",
     "args": {
      "base_url": "${server}/good/",
      "cache_dir": "${cache}",
      "mode": "stream"
     },
     "expect": {
      "loaded_from": "download",
      "datestamp": "20991231.2"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "verify",
     "expect": {
      "verified": true
     }
    },
    {
     "driver": "corrupt",
     "path": "${cache}/v1/releases/20991231.2/OTC_20991231.2.jsonl",
     "offset": 50
    },
    {
     "op": "verify",
     "expect": {
      "error": "checksum_mismatch"
     }
    }
   ]
  },
  {
   "id": "cache/not-writable",
   "title": "a cache directory that cannot be created: cache error",
   "spec": "4.8",
   "requires": [
    "fs"
   ],
   "steps": [
    {
     "driver": "write",
     "path": "${tmp}/not-a-dir",
     "text": "x"
    },
    {
     "op": "open",
     "args": {
      "base_url": "${server}/good/",
      "cache_dir": "${tmp}/not-a-dir/cache"
     },
     "expect": {
      "error": "cache"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    }
   ]
  },
  {
   "id": "cache/files-from-verified",
   "title": "loaded_from cache: release.files comes from .verified",
   "spec": "4.3.1",
   "requires": [
    "fs"
   ],
   "steps": [
    {
     "op": "open",
     "args": {
      "base_url": "${server}/good/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "loaded_from": "download",
      "datestamp": "20991231.2"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "driver": "restart_runner"
    },
    {
     "driver": "server_stop"
    },
    {
     "op": "open",
     "args": {
      "release": "20991231.2",
      "base_url": "${server}/good/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "loaded_from": "cache",
      "datestamp": "20991231.2"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "release_files",
     "expect": {
      "files": {
       "$all": [
        {
         "$type": "array"
        },
        {
         "$len_min": 1
        }
       ]
      }
     }
    }
   ]
  }
 ]
}
