  {
   "id": "bbox-browser/rectangle-eager",
   "title": "bbox rectangle: ordered inclusive discovery",
   "spec": "SDK-BBOX",
   "requires": [
    "station_bbox",
    "fetch",
    "eager"
   ],
   "runners": [
    "typescript-browser"
   ],
   "steps": [
    {
     "op": "open",
     "args": {
      "release": "20991231.2",
      "base_url": "${server}/good/",
      "mode": "eager"
     },
     "expect": {
      "datestamp": "20991231.2"
     }
    },
    {
     "op": "bbox",
     "args": {
      "south": 37.665,
      "west": -122.4659,
      "north": 37.8063,
      "east": -122.3
     },
     "expect": {
      "station_ids": [
       "OTC-T-0001",
       "OTC-T-0003",
       "OTC-T-0004"
      ]
     }
    },
    {
     "op": "hold_release",
     "args": {
      "name": "held"
     }
    },
    {
     "op": "bbox",
     "args": {
      "south": 37.665,
      "west": -122.4659,
      "north": 37.8063,
      "east": -122.3
     },
     "on": "held",
     "expect": {
      "station_ids": [
       "OTC-T-0001",
       "OTC-T-0003",
       "OTC-T-0004"
      ]
     }
    }
   ]
  },
