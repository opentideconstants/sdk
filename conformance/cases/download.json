  {
   "id": "download/from-cache",
   "title": "download-from-cache: the cache holds the release, the server is stopped, no request",
   "spec": "4.3.2, 7.1",
   "requires": [
    "stream"
   ],
   "steps": [
    {
     "op": "open",
     "args": {
      "base_url": "${server}/good/",
      "mode": "stream"
     },
     "expect": {
      "loaded_from": "download",
