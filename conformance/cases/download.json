     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "driver": "server_stop"
    },
    {
     "driver": "clear_log"
    },
    {
     "op": "download",
     "args": {
      "release": "20991231.2",
      "to": "${tmp}/bundle"
     },
     "expect": {
      "paths": [
       "OTC_20991231.2.jsonl",
       "OTC_20991231.2.meta.json",
       "OTC_20991231.2.sha256"
      ]
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      },
      "fs": {
       "error": "unsupported"
      }
     }
