  {
   "id": "download/mismatch",
   "title": "download-mismatch: a changed file fails with file_exists and stays; overwrite repairs it",
   "spec": "4.3.2, 7.1",
   "requires": [],
   "steps": [
    {
     "op": "open",
     "args": {
      "base_url": "${server}/good/"
     },
     "expect": {
      "loaded_from": "download",
      "datestamp": "20991231.2"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "download",
     "args": {
      "release": "20991231.2",
      "to": "${tmp}/bundle"
     },
     "expect": {
      "paths": [
       "OTC_20991231.2.jsonl",
       "OTC_20991231.2.meta.json",
       "OTC_20991231.2.sha256"
      ]
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      },
      "fs": {
       "error": "unsupported"
      }
     }
    },
    {
     "driver": "corrupt",
     "path": "${tmp}/bundle/OTC_20991231.2.jsonl",
     "offset": 10
    },
    {
     "op": "download",
     "args": {
      "release": "20991231.2",
      "to": "${tmp}/bundle"
     },
     "expect": {
      "error": "file_exists",
      "error_fields": {
       "path": {
        "$contains": "OTC_20991231.2.jsonl"
       }
      }
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      },
      "fs": {
       "error": "unsupported"
      }
     }
    },
    {
     "driver": "assert_sha256",
     "path": "${tmp}/bundle/OTC_20991231.2.jsonl",
     "equals": "${fixtures}/good/OTC_20991231.2.jsonl",
     "negate": true
    },
    {
     "op": "download",
     "args": {
      "release": "20991231.2",
      "to": "${tmp}/bundle",
      "overwrite": true
     },
     "expect": {
      "paths": [
       "OTC_20991231.2.jsonl"
      ]
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      },
      "fs": {
       "error": "unsupported"
      }
     }
    },
    {
     "driver": "assert_sha256",
     "path": "${tmp}/bundle/OTC_20991231.2.jsonl",
     "equals": "${fixtures}/good/OTC_20991231.2.jsonl"
    },
    {
     "driver": "assert_sha256",
     "path": "${tmp}/bundle/OTC_20991231.2.meta.json",
     "equals": "${fixtures}/good/OTC_20991231.2.meta.json"
    },
    {
     "driver": "assert_sha256",
     "path": "${tmp}/bundle/OTC_20991231.2.sha256",
     "equals": "${fixtures}/good/OTC_20991231.2.sha256"
    }
   ]
  },
