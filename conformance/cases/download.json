  {
   "id": "download/latest-network-error-use-cache",
   "title": "download of latest when the pointer answers 500, with use_cache and a cached release: writes the newest cached release",
   "spec": "4.3.2, 5.2",
   "requires": [
    "fs"
   ],
   "timeout_s": 90,
   "steps": [
    {
     "op": "open",
     "args": {
      "base_url": "${server}/good/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "loaded_from": "download",
      "datestamp": "20991231.2"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "driver": "server_rules",
     "rules": [
      {
