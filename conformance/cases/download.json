  {
   "id": "download/mismatch",
   "title": "download-mismatch: a changed file fails with file_exists and stays; overwrite repairs it",
   "spec": "4.3.2, 7.1",
   "requires": [],
   "steps": [
    {
     "op": "open",
     "args": {
      "base_url": "${server}/good/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "loaded_from": "download",
      "datestamp": "20991231.2"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "download",
     "args": {
      "release": "20991231.2",
      "to": "${tmp}/bundle"
     },
     "expect": {
      "paths": [
       "OTC_20991231.2.jsonl",
       "OTC_20991231.2.meta.json",
       "OTC_20991231.2.sha256"
      ]
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      },
      "fs": {
       "error": "unsupported"
      }
     }
    },
    {
     "driver": "corrupt",
     "path": "${tmp}/bundle/OTC_20991231.2.jsonl",
     "offset": 10
    },
    {
     "op": "download",
     "args": {
      "release": "20991231.2",
      "to": "${tmp}/bundle"
     },
     "expect": {
      "error": "file_exists",
      "error_fields": {
       "path": {
        "$contains": "OTC_20991231.2.jsonl"
       }
      }
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      },
      "fs": {
       "error": "unsupported"
      }
     }
    },
    {
     "driver": "assert_sha256",
     "path": "${tmp}/bundle/OTC_20991231.2.jsonl",
     "equals": "${fixtures}/good/OTC_20991231.2.jsonl",
     "negate": true
    },
    {
     "op": "download",
     "args": {
      "release": "20991231.2",
      "to": "${tmp}/bundle",
      "overwrite": true
     },
     "expect": {
      "paths": [
       "OTC_20991231.2.jsonl"
      ]
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      },
      "fs": {
       "error": "unsupported"
      }
     }
    },
    {
     "driver": "assert_sha256",
     "path": "${tmp}/bundle/OTC_20991231.2.jsonl",
     "equals": "${fixtures}/good/OTC_20991231.2.jsonl"
    },
    {
     "driver": "assert_sha256",
     "path": "${tmp}/bundle/OTC_20991231.2.meta.json",
     "equals": "${fixtures}/good/OTC_20991231.2.meta.json"
    },
    {
     "driver": "assert_sha256",
     "path": "${tmp}/bundle/OTC_20991231.2.sha256",
     "equals": "${fixtures}/good/OTC_20991231.2.sha256"
    }
   ]
  },
  {
   "id": "download/conflict-changes-nothing",
   "title": "a conflict is found before any write: a missing file is not written either",
   "spec": "4.3.2",
   "requires": [],
   "steps": [
    {
     "op": "open",
     "args": {
      "base_url": "${server}/good/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "loaded_from": "download",
      "datestamp": "20991231.2"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "download",
     "args": {
      "release": "20991231.2",
      "to": "${tmp}/bundle"
     },
     "expect": {
      "paths": [
       "OTC_20991231.2.jsonl",
       "OTC_20991231.2.meta.json",
       "OTC_20991231.2.sha256"
      ]
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      },
      "fs": {
       "error": "unsupported"
      }
     }
    },
    {
     "driver": "corrupt",
     "path": "${tmp}/bundle/OTC_20991231.2.jsonl",
     "offset": 10
    },
    {
     "driver": "delete",
     "path": "${tmp}/bundle/OTC_20991231.2.meta.json"
    },
    {
     "op": "download",
     "args": {
      "release": "20991231.2",
      "to": "${tmp}/bundle"
     },
     "expect": {
      "error": "file_exists"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      },
      "fs": {
       "error": "unsupported"
      }
     }
    },
    {
     "driver": "assert_files",
     "dir": "${tmp}/bundle",
     "exactly": [
      "OTC_20991231.2.jsonl",
      "OTC_20991231.2.sha256"
     ]
    }
   ]
  },
  {
   "id": "download/from-cache",
   "title": "download-from-cache: the cache holds the release, the server is stopped, no request",
   "spec": "4.3.2, 7.1",
   "requires": [],
   "steps": [
    {
     "op": "open",
     "args": {
      "base_url": "${server}/good/",
      "cache_dir": "${cache}",
      "mode": "stream"
     },
     "expect": {
      "loaded_from": "download",
      "datestamp": "20991231.2"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "driver": "server_stop"
    },
    {
     "driver": "clear_log"
    },
    {
     "op": "download",
     "args": {
      "release": "20991231.2",
      "to": "${tmp}/bundle"
     },
     "expect": {
      "paths": [
       "OTC_20991231.2.jsonl",
       "OTC_20991231.2.meta.json",
       "OTC_20991231.2.sha256"
      ]
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      },
      "fs": {
       "error": "unsupported"
      }
     }
    },
    {
     "driver": "assert_requests",
     "source": "any",
     "count": 0
    },
    {
     "driver": "assert_sha256",
     "path": "${tmp}/bundle/OTC_20991231.2.jsonl",
     "equals": "${fixtures}/good/OTC_20991231.2.jsonl"
    },
    {
     "driver": "assert_sha256",
     "path": "${tmp}/bundle/OTC_20991231.2.meta.json",
     "equals": "${fixtures}/good/OTC_20991231.2.meta.json"
    },
    {
     "driver": "assert_sha256",
     "path": "${tmp}/bundle/OTC_20991231.2.sha256",
     "equals": "${fixtures}/good/OTC_20991231.2.sha256"
    }
   ]
  },
  {
   "id": "download/bad-checksum",
   "title": "download-bad-checksum: the server sends a file with a wrong SHA-256; checksum_mismatch and the file is not in the folder",
   "spec": "4.3.2, 7.1",
   "requires": [
    "fs"
   ],
   "steps": [
    {
     "op": "open",
     "args": {
      "file": "${fixtures}/good/OTC_20991231.2.jsonl",
      "base_url": "${server}/bad/wrong-sha256/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "loaded_from": "file"
     }
    },
    {
     "op": "download",
     "args": {
      "release": "20991231",
      "to": "${tmp}/bundle"
     },
     "expect": {
      "error": "checksum_mismatch"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      },
      "fs": {
       "error": "unsupported"
      }
     }
    },
    {
     "driver": "assert_files",
     "dir": "${tmp}/bundle",
     "absent": [
      "OTC_20991231.jsonl"
     ],
     "no_tmp": true,
     "may_be_missing": true
    }
   ]
  },
  {
   "id": "download/formats",
   "title": "download every format: json, json.gz, jsonl, plus meta and sha256",
   "spec": "4.3.2",
   "requires": [],
   "steps": [
    {
     "op": "open",
     "args": {
      "base_url": "${server}/good/",
