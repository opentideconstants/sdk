{
 "suite_version": "1.0",
 "group": "download",
 "description": "Generated by conformance/tools/build_cases.py from conformance/fixtures; do not edit.",
 "cases": [
  {
   "id": "download/then-open",
   "title": "download-then-open: download writes jsonl, meta and sha256; file: on the result is loaded_from file and verify passes",
   "spec": "4.3.2, 7.1",
   "requires": [],
   "steps": [
    {
     "op": "open",
     "args": {
      "base_url": "${server}/good/"
     },
     "expect": {
      "loaded_from": "download",
      "datestamp": "20991231.2"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "download",
     "args": {
      "release": "20991231.2",
      "to": "${tmp}/bundle"
     },
     "expect": {
      "paths": [
       "OTC_20991231.2.jsonl",
       "OTC_20991231.2.meta.json",
       "OTC_20991231.2.sha256"
      ]
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      },
      "fs": {
       "error": "unsupported"
      }
     }
    },
    {
     "driver": "assert_files",
     "dir": "${tmp}/bundle",
     "exactly": [
      "OTC_20991231.2.jsonl",
      "OTC_20991231.2.meta.json",
      "OTC_20991231.2.sha256"
     ]
    },
    {
     "driver": "assert_sha256",
     "path": "${tmp}/bundle/OTC_20991231.2.jsonl",
     "equals": "${fixtures}/good/OTC_20991231.2.jsonl"
    },
    {
     "driver": "assert_sha256",
     "path": "${tmp}/bundle/OTC_20991231.2.meta.json",
     "equals": "${fixtures}/good/OTC_20991231.2.meta.json"
    },
    {
     "driver": "assert_sha256",
     "path": "${tmp}/bundle/OTC_20991231.2.sha256",
     "equals": "${fixtures}/good/OTC_20991231.2.sha256"
    },
    {
     "op": "open",
     "args": {
      "file": "${tmp}/bundle/OTC_20991231.2.jsonl"
     },
     "expect": {
      "loaded_from": "file",
      "datestamp": "20991231.2"
     }
    },
    {
     "op": "verify",
     "expect": {
      "verified": true
     }
    }
   ]
  },
