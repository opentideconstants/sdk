     "expect": {
      "paths": [
       "OTC_20991231.2.json",
       "OTC_20991231.2.json.gz",
       "OTC_20991231.2.jsonl",
       "OTC_20991231.2.meta.json",
       "OTC_20991231.2.sha256"
      ]
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      },
      "fs": {
       "error": "unsupported"
      }
     }
    },
    {
     "driver": "assert_files",
     "dir": "${tmp}/bundle",
     "exactly": [
      "OTC_20991231.2.json",
      "OTC_20991231.2.json.gz",
      "OTC_20991231.2.jsonl",
      "OTC_20991231.2.meta.json",
      "OTC_20991231.2.sha256"
     ]
    },
    {
     "driver": "assert_sha256",
     "path": "${tmp}/bundle/OTC_20991231.2.json",
     "equals": "${fixtures}/good/OTC_20991231.2.json"
    },
    {
     "driver": "assert_sha256",
     "path": "${tmp}/bundle/OTC_20991231.2.json.gz",
     "equals": "${fixtures}/good/OTC_20991231.2.json.gz"
    }
   ]
