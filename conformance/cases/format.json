  {
   "id": "format/latest-offline-cached-index",
   "title": "offline latest when the cache holds a verified release too new for the SDK and the cached index says so: the newest cached readable release, no request",
   "spec": "5.2, 5.5, 7.4",
   "requires": [
    "fs"
   ],
   "steps": [
    {
     "op": "open",
     "args": {
      "release": "20991231.3",
      "base_url": "${server}/reader/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "loaded_from": "download",
      "datestamp": "20991231.3"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "releases",
     "expect": {
      "releases": {
       "$len_min": 3
      }
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "driver": "copy",
     "files": [
      "${fixtures}/reader/OTC_20991231.4.json",
      "${fixtures}/reader/OTC_20991231.4.jsonl",
      "${fixtures}/reader/OTC_20991231.4.meta.json",
      "${fixtures}/reader/OTC_20991231.4.sha256"
     ],
     "to": "${cache}/v1/releases/20991231.4"
    },
    {
     "driver": "write",
     "path": "${cache}/v1/releases/20991231.4/.verified",
     "text": "{\"by\": \"opentideconstants-conformance/1.0\", \"files\": {\"OTC_20991231.4.json\": {\"sha256\": \"956ac5ea846832d0545b2e4db352d30769af233147201f8a3efa8937628a96c9\", \"size\": 6219, \"url\": \"${server}/reader/OTC_20991231.4.json\"}, \"OTC_20991231.4.jsonl\": {\"sha256\": \"f148597c2d842f6031a34af81fdf9a92864ac724c01612274add3cfa2d84ab3a\", \"size\": 2068, \"url\": \"${server}/reader/OTC_20991231.4.jsonl\"}, \"OTC_20991231.4.meta.json\": {\"sha256\": \"accc7c403d057a94ebec849e5cb11fb0cc45f5c82cda1443854b310c4d57d561\", \"size\": 4138, \"url\": \"${server}/reader/OTC_20991231.4.meta.json\"}, \"OTC_20991231.4.sha256\": {\"sha256\": \"0ac6fb6ee74910943db97317afca0270ee588b24a4285a58cc7959f580c68bdb\", \"size\": 353, \"url\": \"${server}/reader/OTC_20991231.4.sha256\"}}, \"verified_at\": \"2099-12-31T20:00:00Z\"}"
    },
    {
     "driver": "restart_runner"
    },
    {
     "driver": "server_stop"
    },
    {
     "driver": "clear_log"
    },
    {
     "op": "open",
     "args": {
      "base_url": "${server}/reader/",
      "cache_dir": "${cache}",
      "offline": true
     },
     "expect": {
      "loaded_from": "cache",
      "datestamp": "20991231.3"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "driver": "assert_requests",
     "source": "any",
     "count": 0
    }
   ]
  },
  {
   "id": "format/latest-use-cache-after-error",
   "title": "the pointer fails and the cache holds only a readable release: loaded_from cache_after_error on it",
   "spec": "5.2, 7.4",
   "requires": [
    "fs"
   ],
   "timeout_s": 90,
   "steps": [
    {
     "op": "open",
     "args": {
      "base_url": "${server}/reader/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "loaded_from": "download",
      "datestamp": "20991231.3"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "driver": "restart_runner"
    },
    {
     "driver": "server_rules",
     "rules": [
      {
       "match": "/reader/OTC_latest(-f1)?\\.json$",
       "action": "status",
       "status": 500
      }
     ]
    },
    {
     "op": "open",
     "args": {
      "base_url": "${server}/reader/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "loaded_from": "cache_after_error",
      "datestamp": "20991231.3"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "last_error",
     "expect": {
      "code": "network"
     }
    }
   ]
  },
