     "count": 0
    }
   ]
  },
  {
   "id": "format/check-for-update-skips-too-new",
   "title": "check_for_update and update skip a release too new for the SDK and move to the newest readable one",
   "spec": "4.3, 5.2, 7.4",
   "requires": [
    "fs"
   ],
   "steps": [
    {
     "driver": "server_rules",
     "rules": [
      {
       "match": "/reader/OTC_latest(-f0)?\\.json$",
       "action": "json",
       "file": "reader/OTC_index.json",
       "pointer": "/releases/2"
      }
     ]
    },
    {
     "op": "open",
     "args": {
      "base_url": "${server}/reader/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "loaded_from": "download",
      "datestamp": "20991231.2"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "driver": "assert_requests",
     "match": "OTC_index\\.json$",
     "count": 0
    },
    {
     "driver": "server_rules",
     "rules": []
    },
    {
     "driver": "clear_log"
    },
    {
     "op": "check_for_update",
     "expect": {
      "release": {
       "datestamp": "20991231.3",
       "format_version": "0.6",
       "concept_doi": "10.5072/zenodo.1",
       "zenodo_version_doi": "10.5072/zenodo.3",
       "content_sha256": "a9ed7bc7838d987a38e4ac9c444e1ca3797ba79f916978af968eeac5718d9e92",
       "files": [
        {
         "name": "OTC_20991231.3.json",
         "url": "${server}/reader/OTC_20991231.3.json",
         "size": 5722,
         "sha256": "bd8b9a464b83af487320ca6c77f24da2bcbee508bfec1d8336103add5ec6ed91"
        },
        {
         "name": "OTC_20991231.3.json.gz",
         "url": "${server}/reader/OTC_20991231.3.json.gz",
         "size": 1762,
         "sha256": "79893fbc04487c9c24e74f6f2d9846d752c1aae5673ca8f5f39f849beab0863d"
        },
        {
         "name": "OTC_20991231.3.jsonl",
         "url": "${server}/reader/OTC_20991231.3.jsonl",
         "size": 2782,
         "sha256": "0c0e87ac45b9274f4af41c2c003dc2de9a986b1b923d1b970c317047b1ba8ec6"
        },
        {
         "name": "OTC_20991231.3.meta.json",
         "url": "${server}/reader/OTC_20991231.3.meta.json",
         "size": 2927,
         "sha256": "abbd0b17248aacbf8e29683dd90ee52820951f6917a461709219c53616f57843"
        },
        {
         "name": "OTC_20991231.3.sha256",
         "url": "${server}/reader/OTC_20991231.3.sha256",
         "size": 353,
         "sha256": "947cee5c26f8889a4d1d261597eb52a41aa6d8e04747a81cca2d86133318e32c"
        }
       ]
      }
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "update",
     "expect": {
      "updated": true,
      "from": "20991231.2",
      "to": "20991231.3"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "release_metadata",
     "expect": {
      "datestamp": "20991231.3"
     }
    },
    {
     "driver": "assert_requests",
     "match": "OTC_20991231\\.4\\.",
     "count": 0
    },
    {
     "op": "check_for_update",
     "expect": {
      "release": null
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "update",
     "expect": {
      "updated": false,
      "from": "20991231.3",
      "to": "20991231.3"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    }
   ]
  },
  {
   "id": "format/download-latest-skips-too-new",
   "title": "download with no release resolves latest the same way: the newest readable release",
   "spec": "4.3.2, 5.2, 7.4",
   "requires": [],
   "steps": [
    {
     "op": "open",
     "args": {
      "release": "20991231.2",
      "base_url": "${server}/reader/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "loaded_from": "download",
      "datestamp": "20991231.2"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "download",
     "args": {
      "to": "${tmp}/bundle"
     },
     "expect": {
      "paths": [
       "OTC_20991231.3.jsonl",
       "OTC_20991231.3.meta.json",
       "OTC_20991231.3.sha256"
      ]
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      },
      "fs": {
       "error": "unsupported"
      }
     }
    },
    {
     "driver": "assert_files",
     "dir": "${tmp}/bundle",
     "exactly": [
      "OTC_20991231.3.jsonl",
      "OTC_20991231.3.meta.json",
      "OTC_20991231.3.sha256"
     ]
    },
    {
     "driver": "assert_requests",
     "match": "OTC_20991231\\.4\\.",
     "count": 0
    },
    {
     "driver": "assert_requests",
     "match": "/reader/OTC_index\\.json$",
     "count": 1
    }
   ]
  }
 ]
