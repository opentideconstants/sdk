  {
   "id": "format/latest-skips-too-new",
   "title": "latest: the pointer names a release too new for the SDK, so one GET of OTC_index.json picks the newest readable one; its files and version DOI come from that entry",
   "spec": "5.2, 4.3.1, 7.4",
   "requires": [
    "fs"
   ],
   "steps": [
    {
     "op": "open",
     "args": {
      "base_url": "${server}/reader/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "loaded_from": "download",
      "datestamp": "20991231.3"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "driver": "assert_requests",
     "match": "/reader/OTC_index\\.json$",
     "count": 1
    },
    {
     "driver": "assert_requests",
     "match": "OTC_20991231\\.4\\.",
     "count": 0
