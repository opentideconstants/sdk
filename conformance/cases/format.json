  {
   "id": "format/latest-offline-cached-index",
   "title": "offline latest when the cache holds a verified release too new for the SDK and the cached index says so: the newest cached readable release, no request",
   "spec": "5.2, 5.5, 7.4",
   "requires": [
    "fs"
   ],
   "steps": [
    {
     "op": "open",
     "args": {
      "release": "20991231.3",
      "base_url": "${server}/reader/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "loaded_from": "download",
      "datestamp": "20991231.3"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "releases",
     "expect": {
      "releases": {
       "$len_min": 3
      }
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "driver": "copy",
     "files": [
      "${fixtures}/reader/OTC_20991231.4.json",
      "${fixtures}/reader/OTC_20991231.4.jsonl",
      "${fixtures}/reader/OTC_20991231.4.meta.json",
      "${fixtures}/reader/OTC_20991231.4.sha256"
     ],
     "to": "${cache}/v1/releases/20991231.4"
    },
    {
     "driver": "write",
     "path": "${cache}/v1/releases/20991231.4/.verified",
     "text": "{\"by\": \"opentideconstants-conformance/1.0\", \"files\": {\"OTC_20991231.4.json\": {\"sha256\": \"7bef647299eff27db0426ea015be4898055d54ecc0ce93001646677f72a0162a\", \"size\": 5057, \"url\": \"${server}/reader/OTC_20991231.4.json\"}, \"OTC_20991231.4.jsonl\": {\"sha256\": \"f148597c2d842f6031a34af81fdf9a92864ac724c01612274add3cfa2d84ab3a\", \"size\": 2068, \"url\": \"${server}/reader/OTC_20991231.4.jsonl\"}, \"OTC_20991231.4.meta.json\": {\"sha256\": \"2733b891cb9def66050022b4ae12e27cdb2cda65b0f018e40fd45a2256b4a07e\", \"size\": 2976, \"url\": \"${server}/reader/OTC_20991231.4.meta.json\"}, \"OTC_20991231.4.sha256\": {\"sha256\": \"0c28a36bec1736bf06472d17723e4ae97bf8170e4e82835d0e25ccfdc3d71c6c\", \"size\": 353, \"url\": \"${server}/reader/OTC_20991231.4.sha256\"}}, \"verified_at\": \"2099-12-31T20:00:00Z\"}"
    },
    {
     "driver": "restart_runner"
    },
    {
     "driver": "server_stop"
    },
    {
     "driver": "clear_log"
    },
    {
     "op": "open",
     "args": {
      "base_url": "${server}/reader/",
      "cache_dir": "${cache}",
      "offline": true
     },
     "expect": {
      "loaded_from": "cache",
      "datestamp": "20991231.3"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "driver": "assert_requests",
     "source": "any",
     "count": 0
    }
   ]
  },
  {
   "id": "format/latest-use-cache-after-error",
   "title": "the pointer fails and the cache holds only a readable release: loaded_from cache_after_error on it",
   "spec": "5.2, 7.4",
   "requires": [
    "fs"
   ],
   "timeout_s": 90,
   "steps": [
    {
     "op": "open",
     "args": {
      "base_url": "${server}/reader/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "loaded_from": "download",
      "datestamp": "20991231.3"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "driver": "restart_runner"
    },
    {
     "driver": "server_rules",
     "rules": [
      {
       "match": "/reader/OTC_latest(-f1)?\\.json$",
       "action": "status",
       "status": 500
      }
     ]
    },
    {
     "op": "open",
     "args": {
      "base_url": "${server}/reader/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "loaded_from": "cache_after_error",
      "datestamp": "20991231.3"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "last_error",
     "expect": {
      "code": "network"
     }
    }
   ]
  },
