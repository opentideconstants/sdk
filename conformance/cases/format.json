  {
   "id": "format/latest-use-cache-after-error",
   "title": "the pointer fails and the cache holds only a readable release: loaded_from cache_after_error on it",
   "spec": "5.2, 7.4",
   "requires": [
    "fs"
   ],
   "timeout_s": 90,
   "steps": [
    {
     "op": "open",
     "args": {
      "base_url": "${server}/reader/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "loaded_from": "download",
      "datestamp": "20991231.3"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "driver": "restart_runner"
    },
    {
     "driver": "server_rules",
     "rules": [
      {
       "match": "/reader/OTC_latest(-f0)?\\.json$",
       "action": "status",
       "status": 500
      }
     ]
    },
    {
     "op": "open",
     "args": {
      "base_url": "${server}/reader/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "loaded_from": "cache_after_error",
      "datestamp": "20991231.3"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "last_error",
     "expect": {
      "code": "network"
     }
    }
   ]
  },
