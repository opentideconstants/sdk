  {
   "id": "format/reader-too-old",
   "title": "min_reader_version newer than the SDK: a file and a pinned load fail with reader_too_old naming both versions; latest loads the newest readable release",
   "spec": "4.8, 5.2, 7.1, 7.4",
   "requires": [
    "fs"
   ],
   "steps": [
    {
     "op": "open",
     "args": {
      "file": "${fixtures}/reader/OTC_20991231.4.jsonl"
     },
     "expect": {
      "error": "reader_too_old",
      "error_message": {
       "$all": [
        {
         "$contains": "0.99"
        },
        {
         "$regex": "(^|[^0-9.])0\\.(?!99([^0-9]|$))[0-9]+([^0-9]|$)"
        }
       ]
      }
     }
    },
    {
     "op": "open",
     "args": {
      "release": "20991231.4",
      "base_url": "${server}/reader/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "error": "reader_too_old",
      "error_message": {
       "$all": [
        {
         "$contains": "0.99"
        },
        {
         "$regex": "(^|[^0-9.])0\\.(?!99([^0-9]|$))[0-9]+([^0-9]|$)"
        }
       ]
      }
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "driver": "clear_log"
    },
    {
     "op": "open",
     "args": {
      "base_url": "${server}/reader/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "loaded_from": "download",
      "datestamp": "20991231.3",
      "format_version": "0.6"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "driver": "assert_requests",
     "match": "/reader/OTC_index\\.json$",
     "count": 1
    }
   ]
  },
