     "expect": {
      "error": "reader_too_old",
      "error_message": {
       "$all": [
        {
         "$contains": "1.99"
        },
        {
         "$regex": "(^|[^0-9.])1\\.(?!99([^0-9]|$))[0-9]+([^0-9]|$)"
        }
       ]
      }
     }
    },
    {
     "op": "open",
     "args": {
      "release": "20991231.4",
      "base_url": "${server}/reader/",
      "cache_dir": "${cache}"
