  {
   "id": "search/qfilt-labelled-fallback",
   "title": "Independent fallback/flagged discovery opt-ins retain explicit metadata and licence basis",
   "spec": "SDK-QFILT",
   "requires": [
    "fs",
    "json",
    "eager"
   ],
   "runners": [
    "python"
   ],
   "steps": [
    {
     "driver": "copy",
     "files": [
      "${fixtures}/good/OTC_20991231.2.json"
     ],
     "to": "${tmp}/filtered"
    },
    {
     "driver": "json_set",
     "path": "${tmp}/filtered/OTC_20991231.2.json",
     "pointer": "/stations/1/constant_sets/0/fallback",
     "value": {
      "reason": "licence_reading",
      "basis": "Actual committed synthetic fixture source evidence"
     }
    },
    {
     "op": "open",
     "args": {
      "file": "${tmp}/filtered/OTC_20991231.2.json"
     },
     "expect": {
      "loaded_from": "file_unverified",
      "datestamp": "20991231.2"
     }
    },
    {
     "op": "search",
     "args": {
      "source": "ticon-fallback",
      "include_flagged": false,
      "include_fallback": false,
      "name": "South San Francisco",
      "match": "exact",
      "limit": 1
     },
     "expect": {
      "station_ids": []
     }
    },
    {
     "op": "search",
     "args": {
      "source": "ticon-fallback",
      "include_flagged": true,
      "include_fallback": false,
      "name": "South San Francisco",
      "match": "exact",
      "limit": 1
     },
     "expect": {
      "station_ids": []
     }
    },
    {
     "op": "search",
     "args": {
      "source": "ticon-fallback",
      "include_flagged": false,
      "include_fallback": true,
      "name": "South San Francisco",
      "match": "exact",
      "limit": 1
     },
     "expect": {
      "station_ids": [
       "OTC-T-0002"
      ]
     }
