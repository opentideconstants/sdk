  {
   "id": "load/files-file-sha256-complete",
   "title": "loaded_from file: release.files lists every name in .sha256 with stat sizes",
   "spec": "4.3.1",
   "requires": [
    "fs"
   ],
   "steps": [
    {
     "op": "open",
     "args": {
      "file": "${fixtures}/good/OTC_20991231.2.jsonl"
     },
     "expect": {
      "loaded_from": "file",
      "datestamp": "20991231.2"
     }
    },
    {
     "op": "release_files",
     "expect": {
      "files": [
       {
        "name": "OTC_20991231.2.json",
        "url": null,
        "size": 21765,
        "sha256": "b1fede2fc916dbae6131a3644e84785dcc1123f334b3eef202275ad3bee78ff2"
       },
       {
        "name": "OTC_20991231.2.json.gz",
