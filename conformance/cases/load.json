  {
   "id": "load/verify-file",
   "title": "verify passes on an intact file and fails with checksum_mismatch after one byte changes",
   "spec": "4.3, 5.3",
   "requires": [
    "fs"
   ],
   "steps": [
    {
     "driver": "copy",
     "files": [
      "${fixtures}/good/OTC_20991231.2.jsonl",
      "${fixtures}/good/OTC_20991231.2.meta.json",
      "${fixtures}/good/OTC_20991231.2.sha256"
     ],
     "to": "${tmp}/rel"
    },
    {
     "op": "open",
     "args": {
      "file": "${tmp}/rel/OTC_20991231.2.jsonl"
     },
     "expect": {
      "loaded_from": "file"
     }
    },
    {
     "op": "verify",
     "expect": {
      "verified": true
     }
    },
    {
     "driver": "corrupt",
     "path": "${tmp}/rel/OTC_20991231.2.jsonl",
     "offset": 100
    },
    {
     "op": "verify",
     "expect": {
      "error": "checksum_mismatch",
      "error_fields": {
       "file": {
        "$contains": "OTC_20991231.2.jsonl"
       },
       "expected": "759d6bb9e54684e82c3a007d8970e2ac5e3df19a3c2093f74c3fbc1bd69499b1",
       "actual": {
        "$regex": "^[0-9a-f]{64}$"
       }
      }
     }
    }
   ]
  },
