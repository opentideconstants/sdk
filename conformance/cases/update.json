{
 "suite_version": "1.0",
 "group": "update",
 "description": "Generated by conformance/tools/build_cases.py from conformance/fixtures; do not edit.",
 "cases": [
  {
   "id": "update/pinned",
   "title": "update on a pinned client: pinned_release",
   "spec": "4.3, 4.8",
   "requires": [
    "fs"
   ],
   "steps": [
    {
     "op": "open",
     "args": {
      "release": "20991231",
      "base_url": "${server}/good/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "datestamp": "20991231"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "update",
     "expect": {
      "error": "pinned_release"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    }
   ]
  },
  {
   "id": "update/file",
   "title": "update on a client opened from a file: pinned_release",
   "spec": "4.3, 4.8",
   "requires": [
    "fs"
   ],
   "steps": [
    {
     "op": "open",
     "args": {
      "file": "${fixtures}/good/OTC_20991231.2.jsonl"
     },
     "expect": {
      "loaded_from": "file"
     }
    },
    {
     "op": "update",
     "expect": {
      "error": "pinned_release"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    }
   ]
  },
  {
   "id": "update/swap",
   "title": "update swaps to the newer release; a Release held from before still shows the old one",
   "spec": "4.3, 5.6",
   "requires": [
    "fs"
   ],
   "steps": [
    {
     "driver": "server_rules",
     "rules": [
      {
       "match": "/good/OTC_latest(-f1)?\\.json$",
       "action": "json",
       "file": "good/OTC_index.json",
       "pointer": "/releases/1"
      }
     ]
    },
    {
     "op": "open",
     "args": {
      "base_url": "${server}/good/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "loaded_from": "download",
      "datestamp": "20991231"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "hold_release",
     "args": {
      "name": "old"
     }
    },
    {
     "driver": "server_rules",
     "rules": []
    },
    {
     "op": "update",
     "expect": {
      "updated": true,
      "from": "20991231",
      "to": "20991231.2"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "release_metadata",
     "expect": {
      "datestamp": "20991231.2"
     }
    },
    {
     "op": "station",
     "args": {
      "station_id": "OTC-T-0021"
     },
     "expect": {
      "station": null
     }
    },
    {
     "op": "release_metadata",
     "on": "old",
     "expect": {
      "datestamp": "20991231"
     }
    },
    {
     "op": "station",
     "args": {
      "station_id": "OTC-T-0021"
     },
     "on": "old",
     "expect": {
      "station": {
       "station_id": "OTC-T-0021",
       "name": "Closing Pier",
       "country": "GBR",
       "lat": 52.0,
       "lon": 1.7,
       "type": "reference",
       "kind": "tide",
       "timezone": "Europe/London",
       "aliases": {},
       "status": "active",
       "is_reference": true,
       "is_subordinate": false,
       "is_tide": true,
       "is_current": false,
       "recommended_set_id": "OTC-T-0021/gesla-fit"
      }
     }
    }
   ]
  },
  {
   "id": "update/none",
   "title": "update when the loaded release is the newest: updated false, from = to",
   "spec": "4.3",
   "requires": [
    "fs"
   ],
   "steps": [
    {
     "op": "open",
     "args": {
      "base_url": "${server}/good/",
      "cache_dir": "${cache}"
     },
     "expect": {
      "loaded_from": "download",
      "datestamp": "20991231.2"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "update",
     "expect": {
      "updated": false,
      "from": "20991231.2",
      "to": "20991231.2"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "op": "release_metadata",
     "expect": {
      "datestamp": "20991231.2"
     }
    }
   ]
  },
  {
   "id": "update/auto",
   "title": "auto_update with update_interval 1 s: the first query after the interval switches the release",
   "spec": "5.6",
   "requires": [
    "fs"
   ],
   "steps": [
    {
     "driver": "server_rules",
     "rules": [
      {
       "match": "/good/OTC_latest(-f1)?\\.json$",
       "action": "json",
       "file": "good/OTC_index.json",
       "pointer": "/releases/1"
      }
     ]
    },
    {
     "op": "open",
     "args": {
      "base_url": "${server}/good/",
      "cache_dir": "${cache}",
      "auto_update": true,
      "update_interval": 1
     },
     "expect": {
      "datestamp": "20991231"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "driver": "server_rules",
     "rules": []
    },
    {
     "driver": "sleep",
     "s": 2.5
    },
    {
     "op": "station",
     "args": {
      "station_id": "OTC-T-0021"
     },
     "expect": {
      "station": null
     }
    },
    {
     "op": "release_metadata",
     "expect": {
      "datestamp": "20991231.2"
     }
    }
   ]
  },
  {
   "id": "update/last-error-cleared-auto",
   "title": "an automatic update fails (last_error network); the next automatic check reaches the pointer and finds nothing newer: last_error is null, loaded_from unchanged (CR2 DR4)",
   "spec": "4.3, 5.6",
   "requires": [
    "fs"
   ],
   "timeout_s": 120,
   "steps": [
    {
     "op": "open",
     "args": {
      "base_url": "${server}/good/",
      "cache_dir": "${cache}",
      "auto_update": true,
      "update_interval": 1
     },
     "expect": {
      "loaded_from": "download",
      "datestamp": "20991231.2"
     },
     "expect_if_missing": {
      "fetch": {
       "error": "not_built"
      }
     }
    },
    {
     "driver": "server_rules",
     "rules": [
      {
       "match": "/good/OTC_latest(-f1)?\\.json$",
       "action": "status",
       "status": 500
      }
     ]
    },
    {
     "driver": "sleep",
     "s": 1.5
    },
    {
     "op": "station",
     "args": {
      "station_id": "OTC-T-0001"
     },
     "expect": {
      "station": {
       "$type": "object"
      }
     }
    },
    {
     "op": "last_error",
     "expect": {
      "code": "network"
     }
    },
    {
     "driver": "server_rules",
     "rules": []
    },
    {
     "driver": "sleep",
     "s": 1.5
    },
    {
     "op": "station",
     "args": {
      "station_id": "OTC-T-0001"
     },
     "expect": {
      "station": {
       "$type": "object"
      }
     }
    },
    {
     "op": "last_error",
     "expect": {
      "code": null
     }
    },
    {
     "op": "loaded_from",
     "expect": {
      "loaded_from": "download"
     }
    }
   ]
  },
